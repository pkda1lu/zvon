{
  "name": "zvon-client",
  "version": "0.1.1",
  "private": true,
  "author": "pkda1lu",
  "description": "Zvon - Real-time communication platform",
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.68",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "axios": "^1.6.2",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.6.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "main": "public/electron.js",
  "homepage": "./",
  "build": {
    "appId": "com.zvon.app",
    "productName": "Zvon",
    "win": {
      "target": "nsis",
      "icon": "public/app_icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "files": [
      "build/**/*"
    ],
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pkda1lu",
        "repo": "zvon"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pkda1lu/zvon.git"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron:dev": "concurrently \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "cross-env GENERATE_SOURCEMAP=false npm run build && node -e \"const fs=require('fs');fs.copyFileSync('public/electron.js','build/electron.js');fs.copyFileSync('public/preload.js','build/preload.js');fs.copyFileSync('public/updater.html','build/updater.html')\" && electron-builder -w -c.extraMetadata.main=build/electron.js -c.compression=store"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "wait-on": "^9.0.3"
  }
}