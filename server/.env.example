PORT=5000
# Адрес, на котором слушает приложение. По умолчанию только петля: снаружи
# сервис доступен через nginx. Открывать на все интерфейсы (0.0.0.0) можно,
# только если порт закрыт фаерволом, — иначе обходится nginx и подделывается IP.
BIND_HOST=127.0.0.1
MONGODB_URI=mongodb://localhost:27017/zvon
JWT_SECRET=your_jwt_secret
CLIENT_URL=http://localhost:3000

# SteamGridDB API Key (Optional, for game icons)
# Get it from: https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# GIPHY API Key (for GIF picker)
# Get it from: https://developers.giphy.com/dashboard/ (Create an App -> API)
GIPHY_API_KEY=

# Web Push (уведомления в веб-версии и PWA, в т.ч. на iOS).
# Сгенерировать пару один раз: node server/scripts/generateVapidKeys.js
# ВАЖНО: смена ключей делает недействительными все существующие подписки —
# пользователям придётся заново включать уведомления.
# Если ключи не заданы, push просто отключён, остальное работает как раньше.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@example.com

# Почта. SMTP_HOST обязателен — значения по умолчанию нет намеренно,
# чтобы письма не уходили молча через иностранный сервис.
# Свой сервер на этой же машине (см. docs/pochta-svoy-server.md):
#   SMTP_HOST=127.0.0.1, SMTP_PORT=25, логин и пароль не нужны.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Адрес в поле From. Должен быть на домене, для которого настроены SPF и DKIM.
MAIL_FROM=noreply@zvonserver.ru

# --- Интеграция с Telegram-ботом Vlyne (общая VPN-подписка) ---
# Адрес webapp бота (miniapp.py, по умолчанию слушает порт 8080).
# Если бот на той же машине — оставьте loopback: наружу этот порт открывать не нужно.
VLYNE_BOT_URL=http://127.0.0.1:8080
# Общий секрет. ТОТ ЖЕ ключ должен стоять в переменной ZVON_API_KEY у бота.
# Сгенерировать: openssl rand -hex 32
ZVON_API_KEY=
# Таймаут запросов к боту, мс (необязательно)
VLYNE_BOT_TIMEOUT_MS=20000

# --- Vlyne ID (единый вход в экосистему) ---
# Адрес, который приложения видят снаружи. Он попадает в поле iss каждого
# токена, и проверяющие сравнивают его посимвольно: расхождение в схеме или
# завершающем слэше сделает все токены недействительными.
# Поддомен, а не основной домен: Vlyne ID — отдельный продукт, и сторонние
# сервисы должны видеть в настройках его адрес, а не адрес Zvon. Определиться
# нужно ДО выдачи первых токенов: смена issuer позже обнулит все выданные.
VLYNE_ID_ISSUER=https://vlyneid.zvonserver.ru
# Где живёт экран согласия (фронтенд Zvon). Здесь как раз основной домен:
# человек подтверждает вход там, где уже вошёл в свой аккаунт.
VLYNE_ID_WEB_URL=https://zvonserver.ru
# Ключ подписи RS256. Если не задан ни PEM, ни путь к файлу — при первом
# запуске ключ генерируется в server/data/vlyne-id/private.pem.
# ВНИМАНИЕ: при смене ключа все выданные токены перестают проверяться.
# VLYNE_ID_KEY_FILE=/etc/vlyne/vlyne-id.pem
# VLYNE_ID_PRIVATE_KEY=
